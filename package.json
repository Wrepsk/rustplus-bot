{
  "name": "rust-discord-base-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Rust+ base controls, smart alarm alerts and team chat for Discord",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "pair": "tsx src/pairing/helper.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests",
    "format": "prettier --write src tests package.json tsconfig.json tsconfig.test.json eslint.config.mjs README.md docker-compose.yml .prettierrc.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@liamcottle/rustplus.js": "2.5.0",
    "discord.js": "14.27.0",
    "dotenv": "^17.2.3",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "protobufjs": "^7.6.6",
    "request": {
      "form-data": "^2.5.6",
      "qs": "^6.16.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3",
    "ws": "^8.18.3"
  }
}
