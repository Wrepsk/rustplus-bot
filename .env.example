# Required Discord credentials (Developer Portal). Never commit .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
ADMIN_USER_ID=

# Server-pairing notification fields: ip, port, playerId, playerToken.
# These bootstrap the original/default server. Add/switch servers with /pair and /server.
# Friends must link their own Rust+ identity through /pair before relaying chat.
# Port is the Rust+ app port, NOT the game/RCON port. Token may be negative.
RUST_SERVER_IP=
RUST_APP_PORT=28082
RUST_STEAM_ID=
RUST_PLAYER_TOKEN=
# Secure Facepunch WebSocket proxy; false uses direct plaintext ws://.
RUST_USE_PROXY=true

# Optional HTTPS URL to your published Windows pairing ZIP (not the source-code ZIP).
# Build it with npm run package:pairing on Windows, or the Pairing Helper workflow.
# Friends use this download button in /pair start; never put credentials in this URL.
PAIRING_HELPER_URL=

# Optional self-hosted browser pairing. Use a dedicated HTTPS origin, no path/query.
# Leave blank to retain desktop-helper pairing. Requires your HTTPS reverse proxy.
PAIRING_WEB_URL=
PAIRING_WEB_HOST=127.0.0.1
PAIRING_WEB_PORT=3080

DATABASE_PATH=./data/bot.sqlite
# Comma-separated operator roles; no roles means administrators only.
# /settings role-add overrides this initial list in SQLite.
ALLOWED_ROLE_IDS=
ALERT_CHANNEL_ID=
ALERT_ROLE_ID=
BASE_NAME=Main Base
ALARM_COOLDOWN_SECONDS=60
CHAT_POLL_SECONDS=30
RUST_CHAT_MAX_LENGTH=128
LOG_LEVEL=info
